<Window x:Class="SmartXDashboard.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X Access Gateway" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E10"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Dark Input Field Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#18181C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,12,12,12"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFC700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#18181C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,12,12,12"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFC700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Red Action Button -->
        <Style x:Key="RedPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E50914"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B80710"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Toggle Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8A8A93"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" Padding="0,0,0,8" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFC700"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFC700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Hero Panel -->
            <ColumnDefinition Width="420"/>
            <!-- Right Form Panel -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: Industrial Graphic Hero Section -->
        <Grid Grid.Column="0" Background="#141418">
            <Rectangle Width="6" Fill="#E50914" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>

            <Canvas Opacity="0.15">
                <Line X1="0" Y1="100" X2="420" Y2="100" Stroke="#FFC700" StrokeThickness="1"/>
                <Line X1="0" Y1="250" X2="420" Y2="250" Stroke="#FFFFFF" StrokeThickness="1" StrokeDashArray="4 4"/>
                <Line X1="0" Y1="400" X2="420" Y2="400" Stroke="#FFFFFF" StrokeThickness="1" StrokeDashArray="4 4"/>
                <Line X1="0" Y1="520" X2="420" Y2="520" Stroke="#E50914" StrokeThickness="1"/>

                <Line X1="100" Y1="0" X2="100" Y2="620" Stroke="#FFFFFF" StrokeThickness="1" StrokeDashArray="4 4"/>
                <Line X1="300" Y1="0" X2="300" Y2="620" Stroke="#FFFFFF" StrokeThickness="1" StrokeDashArray="4 4"/>
            </Canvas>

            <Ellipse Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFC700" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel VerticalAlignment="Center" Margin="48,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Rectangle Width="12" Height="12" Fill="#FFC700" Margin="0,0,8,0"/>
                    <TextBlock Text="SYSTEM ONLINE" FontSize="11" FontWeight="Bold" Foreground="#FFC700"/>
                </StackPanel>

                <TextBlock Text="SMART-X" FontSize="36" FontWeight="Black" Foreground="#FFFFFF"/>
                <TextBlock Text="IoT Mesh Platform" FontSize="18" FontWeight="SemiBold" Foreground="#8A8A93" Margin="0,2,0,20"/>

                <Rectangle Height="2" Width="60" Fill="#E50914" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                <TextBlock Text="High-throughput telemetry ingestion &amp; real-time gateway administration." 
                           FontSize="13" Foreground="#A0A0AB" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>

            <Border VerticalAlignment="Bottom" Margin="48,0,48,32" Background="#1C1C22" Padding="12" CornerRadius="6" BorderBrush="#2A2A32" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#34C759" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="GATEWAY ADAPTER: ACTIVE (NET 10)" FontSize="10" FontWeight="Bold" Foreground="#8A8A93"/>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT PANEL: Clean Tabbed Form Section -->
        <Grid Grid.Column="1" Background="#0E0E10" Margin="48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Navigation Tabs (Log In vs Register) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,32">
                <RadioButton x:Name="TabLogin" Content="LOG IN" Style="{StaticResource TabButtonStyle}" IsChecked="True" Click="TabLogin_Click" Margin="0,0,32,0"/>
                <RadioButton x:Name="TabRegister" Content="REGISTER OPERATOR" Style="{StaticResource TabButtonStyle}" Click="TabRegister_Click"/>
            </StackPanel>

            <!-- FORM CONTENT AREA -->
            <Grid Grid.Row="1" VerticalAlignment="Top">

                <!-- LOGIN FORM -->
                <StackPanel x:Name="LoginForm" Visibility="Visible">
                    <TextBlock Text="Welcome back" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <TextBlock Text="Enter your credentials to access the telemetry gateway." FontSize="13" Foreground="#8A8A93" Margin="0,0,0,24"/>

                    <TextBlock Text="OPERATOR ID / EMAIL" FontSize="11" Foreground="#FFC700" FontWeight="Bold"/>
                    <TextBox x:Name="LoginUsernameInput" Style="{StaticResource ModernTextBoxStyle}"/>

                    <TextBlock Text="PASSWORD" FontSize="11" Foreground="#FFC700" FontWeight="Bold"/>
                    <PasswordBox x:Name="LoginPasswordInput" Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,6,0,14"/>

                    <Button Content="AUTHENTICATE &amp; LAUNCH" Style="{StaticResource RedPrimaryButton}" Click="LoginSubmit_Click"/>
                </StackPanel>

                <!-- REGISTER FORM WITH PASSWORD STRENGTH METER -->
                <StackPanel x:Name="RegisterForm" Visibility="Collapsed">
                    <TextBlock Text="Operator Provisioning" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <TextBlock Text="Register a new system operator profile." FontSize="13" Foreground="#8A8A93" Margin="0,0,0,20"/>

                    <TextBlock Text="FULL NAME" FontSize="11" Foreground="#FFC700" FontWeight="Bold"/>
                    <TextBox x:Name="SignupNameInput" Style="{StaticResource ModernTextBoxStyle}"/>

                    <TextBlock Text="EMAIL ADDRESS" FontSize="11" Foreground="#FFC700" FontWeight="Bold"/>
                    <TextBox x:Name="SignupEmailInput" Style="{StaticResource ModernTextBoxStyle}"/>

                    <TextBlock Text="SECURITY PASSWORD" FontSize="11" Foreground="#FFC700" FontWeight="Bold"/>
                    <!-- PasswordChanged Event triggers real-time indicator update -->
                    <PasswordBox x:Name="SignupPasswordInput" Style="{StaticResource ModernPasswordBoxStyle}" PasswordChanged="SignupPasswordInput_PasswordChanged"/>

                    <!-- REAL-TIME PASSWORD STRENGTH INDICATOR -->
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Visual Progress Bar -->
                        <Border Grid.Column="0" Height="4" Background="#18181C" CornerRadius="2" VerticalAlignment="Center">
                            <Border x:Name="StrengthBar" Width="0" HorizontalAlignment="Left" Background="#2A2A32" CornerRadius="2"/>
                        </Border>

                        <!-- Text Indicator -->
                        <TextBlock x:Name="StrengthText" Grid.Column="1" Text="None" FontSize="10" FontWeight="Bold" Foreground="#8A8A93" Margin="10,0,0,0"/>
                    </Grid>

                    <Button Content="CREATE OPERATOR ACCOUNT" Style="{StaticResource RedPrimaryButton}" Click="SignupSubmit_Click"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Window>