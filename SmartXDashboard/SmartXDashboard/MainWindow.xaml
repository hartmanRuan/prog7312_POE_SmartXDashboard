<Window x:Class="SmartXDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X Operational Gateway" Height="720" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E10"
        MinHeight="650" MinWidth="950">

    <Window.Resources>
        <!-- Active Nav Button Style (Yellow Indicator Accent) -->
        <Style x:Key="ActiveNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#FFC700"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,12,16,12"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1,0,0,0" BorderBrush="#FFC700">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inactive Nav Button Style -->
        <Style x:Key="InactiveNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8A93"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12,16,12"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Disabled Nav Button Style for Future Parts -->
        <Style x:Key="DisabledNavButtonStyle" BasedOn="{StaticResource InactiveNavButtonStyle}" TargetType="Button">
            <Setter Property="Foreground" Value="#3A3A42"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>

        <!-- Red Logout Button Style -->
        <Style x:Key="RedLogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E50914"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,10,12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="#3A1014" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E50914"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="280"/>
            <!-- Right Main Operational Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR PANEL -->
        <Border Grid.Column="0" Background="#141418" BorderBrush="#2A2A32" BorderThickness="0,0,1,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Branding Header -->
                <StackPanel Grid.Row="0" Margin="0,10,0,32">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Rectangle Width="10" Height="10" Fill="#E50914" Margin="0,0,8,0"/>
                        <TextBlock Text="SMART-X" FontSize="22" FontWeight="Black" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="GATEWAY CONTROL CENTER" FontSize="10" FontWeight="Bold" Foreground="#8A8A93" Margin="18,0,0,0"/>
                </StackPanel>

                <!-- Architectural Pillar Navigation Links -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="ARCHITECTURAL PILLARS" FontSize="10" FontWeight="Bold" Foreground="#FFC700" Margin="12,0,0,12"/>

                    <!-- Pillar 1: Ingestion & Telemetry (Active for Part 1) -->
                    <Button Content="⚡  Sensor Ingestion &amp; Telemetry" Style="{StaticResource ActiveNavButtonStyle}"/>

                    <!-- Pillar 2: Command Stream (Disabled for Part 2) -->
                    <Button Content="🔒  Command Stream (Part 2)" Style="{StaticResource DisabledNavButtonStyle}"/>

                    <!-- Pillar 3: Network Topology (Disabled for PoE) -->
                    <Button Content="🔒  Network Topology (PoE)" Style="{StaticResource DisabledNavButtonStyle}"/>
                </StackPanel>

                <!-- Footer: Operator Account & Sign Out -->
                <Border Grid.Row="2" Background="#18181C" Padding="16" CornerRadius="8" BorderBrush="#2A2A32" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#34C759" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="OPERATOR ACTIVE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Role: System Admin" FontSize="10" Foreground="#8A8A93"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="DISCONNECT &amp; LOGOUT" Style="{StaticResource RedLogoutButtonStyle}" Click="SignOut_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT MAIN OPERATIONAL PANEL -->
        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top View Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sensor Ingestion &amp; Telemetry Pipeline" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Provision IoT node parameters, register config files, and stream incoming data packets." FontSize="13" Foreground="#8A8A93" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Live Status Badge -->
                <Border Grid.Column="1" Background="#1E1E24" Padding="12,6,12,6" CornerRadius="20" BorderBrush="#2A2A32" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#FFC700" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="API READY" FontSize="10" FontWeight="Bold" Foreground="#FFC700" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DYNAMIC VIEW CONTAINER -->
            <!-- We will inject the Sensor Registration form and Telemetry Data Stream into this ContentControl next -->
            <Border Grid.Row="1" Background="#141418" CornerRadius="10" BorderBrush="#2A2A32" BorderThickness="1" Padding="24">
                <Grid x:Name="MainContentFrame">
                    <TextBlock Text="[ Step 2: Sensor Registration &amp; Config Upload View Will Sit Here ]" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               Foreground="#8A8A93" FontSize="14" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>