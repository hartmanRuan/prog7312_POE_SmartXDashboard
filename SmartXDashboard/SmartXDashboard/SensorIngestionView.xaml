<UserControl x:Class="SmartXDashboard.SensorIngestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Dark Input Field Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#18181C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,10,10,10"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFC700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#18181C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8,10,8"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A32"/>
        </Style>

        <!-- Primary Action Button (Red) -->
        <Style x:Key="RedPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E50914"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,12,12,12"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B80710"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary File Upload Button (Dark Slate with Yellow Border) -->
        <Style x:Key="SecondaryUploadButton" TargetType="Button">
            <Setter Property="Background" Value="#18181C"/>
            <Setter Property="Foreground" Value="#FFC700"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8,10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" 
                                BorderBrush="#FFC700" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFC700"/>
                                <Setter Property="Foreground" Value="#0E0E10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left: Provisioning Form -->
            <ColumnDefinition Width="*"/>
            <!-- Divider -->
            <ColumnDefinition Width="1"/>
            <!-- Right: Barcode & Engagement Preview Panel -->
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: REGISTRATION & CONFIG FILE FORM -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="PROVISION NEW SENSOR NODE" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                <!-- MAC Address Input -->
                <TextBlock Text="SENSOR MAC ADDRESS / NODE ID" FontSize="10" Foreground="#FFC700" FontWeight="Bold"/>
                <TextBox x:Name="MacAddressInput" Style="{StaticResource ModernTextBoxStyle}" Text="00:1A:2B:3C:4D:5E"/>

                <!-- Location Zone Dropdown -->
                <TextBlock Text="DEPLOYMENT LOCATION ZONE" FontSize="10" Foreground="#FFC700" FontWeight="Bold"/>
                <ComboBox x:Name="ZoneComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                    <ComboBoxItem Content="Zone A - Environmental Monitoring"/>
                    <ComboBoxItem Content="Zone B - High-Voltage Power Grid"/>
                    <ComboBoxItem Content="Zone C - Actuator &amp; Valve Control"/>
                    <ComboBoxItem Content="Zone D - Ingestion Gateway Edge"/>
                </ComboBox>

                <!-- Sensor Category Dropdown -->
                <TextBlock Text="TELEMETRY SENSOR CATEGORY" FontSize="10" Foreground="#FFC700" FontWeight="Bold"/>
                <ComboBox x:Name="CategoryComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                    <ComboBoxItem Content="Temperature / Humidity (Environmental)"/>
                    <ComboBoxItem Content="Power / Current Load (Electrical)"/>
                    <ComboBoxItem Content="Actuator Pulse Count (Mechanical)"/>
                </ComboBox>

                <!-- Config File Uploader Section -->
                <TextBlock Text="NODE CONFIGURATION METADATA FILE" FontSize="10" Foreground="#FFC700" FontWeight="Bold" Margin="0,4,0,4"/>
                <Border Background="#18181C" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="FileNameLabel" Text="No file selected (.json, .txt, .log)" FontSize="12" Foreground="#8A8A93"/>
                            <TextBlock x:Name="FileSizeLabel" Text="Size: -- KB" FontSize="10" Foreground="#5A5A62" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="BROWSE..." Style="{StaticResource SecondaryUploadButton}" Click="BrowseConfigFile_Click"/>
                    </Grid>
                </Border>

                <!-- Submit Action -->
                <Button Content="REGISTER NODE &amp; GENERATE BARCODE" Style="{StaticResource RedPrimaryButton}" Click="RegisterSensor_Click"/>
            </StackPanel>
        </Grid>

        <!-- VERTICAL SEPARATOR LINE -->
        <Rectangle Grid.Column="1" Fill="#2A2A32" VerticalAlignment="Stretch"/>

        <!-- RIGHT PANEL: BARCODE & DYNAMIC ENGAGEMENT PREVIEW -->
        <Grid Grid.Column="2" Margin="24,0,0,0">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="DYNAMIC ENGAGEMENT OVERLAY" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                <Border Background="#18181C" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Barcode Image Container -->
                        <Border Background="#FFFFFF" Padding="12" CornerRadius="4" Margin="0,8,0,12" Width="220" Height="140">
                            <Image x:Name="BarcodePreviewImage" Stretch="Uniform"/>
                        </Border>

                        <!-- Generated ID Tag Output -->
                        <TextBlock x:Name="GeneratedNodeIdText" Text="NODE ID: UNPROVISIONED" FontSize="11" FontWeight="Bold" Foreground="#FFC700" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatusTagText" Text="Status: Awaiting Registration" FontSize="11" Foreground="#8A8A93" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1C1C22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="PIPELINE NOTICE" FontSize="10" FontWeight="Bold" Foreground="#E50914"/>
                        <TextBlock Text="Registering a node binds its MAC address to the local memory bus and generates a dynamic barcode key." 
                                   FontSize="11" Foreground="#8A8A93" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>