<UserControl x:Class="SmartXDashboard.TelemetryStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Loaded="TelemetryStreamView_Loaded"
             Unloaded="TelemetryStreamView_Unloaded"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#121212">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Status / Warning Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Top Bar: Filter Dropdown -->
            <RowDefinition Height="*"/>
            <!-- EXPANDED: Timeline Chart filling remaining space -->
        </Grid.RowDefinitions>

        <!-- THRESHOLD WARNING BANNER -->
        <Border x:Name="WarningBanner" Grid.Row="0" Background="#1E3A1E" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" BorderBrush="#2D5A2D" BorderThickness="1">
            <TextBlock x:Name="WarningText" Text="STATUS: NORMAL - All telemetry streams within safe operating thresholds" 
                       Foreground="#4CAF50" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
        </Border>

        <!-- TOP BAR: NODE FILTER DROPDOWN -->
        <Border Grid.Row="1" Background="#181818" CornerRadius="6" Padding="12,10" Margin="0,0,0,15" BorderBrush="#2A2A2A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="FILTER BY REGISTERED NODE:" VerticalAlignment="Center" 
                           FontWeight="Bold" FontSize="11" Foreground="#FFC107" Margin="0,0,12,0"/>

                <ComboBox x:Name="NodeFilterComboBox" Grid.Column="1" Padding="6" FontSize="12" 
                          SelectionChanged="NodeFilterComboBox_SelectionChanged" Foreground="Black">
                    <ComboBoxItem Content="All Registered Nodes" IsSelected="True" Foreground="Black"/>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveNodeStatusText" Text="Active Nodes: 0" Foreground="#888888" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- EXPANDED LIVE TIMELINE GRAPH CONTAINER -->
        <Border Grid.Row="2" Background="#181818" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="LIVE TELEMETRY TIMELINE CHART &amp; THRESHOLDS" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="ChartSelectedNodeLabel" Text="Showing: All Registered Streams" 
                               HorizontalAlignment="Right" FontSize="11" Foreground="#FFC107" FontWeight="SemiBold"/>
                </Grid>

                <!-- CHART VIEW AREA -->
                <Border Grid.Row="1" Background="#121212" CornerRadius="4" BorderBrush="#222222" BorderThickness="1" Padding="10">
                    <Grid x:Name="ChartContainer">
                        <TextBlock x:Name="EmptyChartPrompt" Text="Awaiting telemetry data stream..." 
                                   Foreground="#555555" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Panel.ZIndex="1"/>

                        <!-- LiveCharts2 CartesianChart bound to Series, XAxes, and YAxes -->
                        <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>