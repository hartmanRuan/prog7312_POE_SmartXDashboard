<UserControl x:Class="SmartXDashboard.TelemetryStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#121212">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Bar: Filter Dropdown -->
            <RowDefinition Height="2*"/>
            <!-- EXPANDED: Timeline Chart -->
            <RowDefinition Height="5"/>
            <!-- Separator Splitter -->
            <RowDefinition Height="1*"/>
            <!-- Bottom Half: Live Data Grid -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: NODE FILTER DROPDOWN -->
        <Border Grid.Row="0" Background="#181818" CornerRadius="6" Padding="12,10" Margin="0,0,0,15" BorderBrush="#2A2A2A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="FILTER BY REGISTERED NODE:" VerticalAlignment="Center" 
                           FontWeight="Bold" FontSize="11" Foreground="#FFC107" Margin="0,0,12,0"/>

                <ComboBox x:Name="NodeFilterComboBox" Grid.Column="1" Padding="6" FontSize="12" 
                          SelectionChanged="NodeFilterComboBox_SelectionChanged" Foreground="Black">
                    <ComboBoxItem Content="All Registered Nodes" IsSelected="True" Foreground="Black"/>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveNodeStatusText" Text="Active Nodes: 0" Foreground="#888888" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOP HALF: LIVE TIMELINE GRAPH CONTAINER -->
        <Border Grid.Row="1" Background="#181818" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="1" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="LIVE TELEMETRY TIMELINE CHART" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="ChartSelectedNodeLabel" Text="Showing: All Registered Streams" 
                               HorizontalAlignment="Right" FontSize="11" Foreground="#FFC107" FontWeight="SemiBold"/>
                </Grid>

                <!-- CHART VIEW AREA -->
                <Border Grid.Row="1" Background="#121212" CornerRadius="4" BorderBrush="#222222" BorderThickness="1" Padding="10">
                    <Grid x:Name="ChartContainer" MinHeight="320">
                        <TextBlock x:Name="EmptyChartPrompt" Text="Awaiting telemetry data stream..." 
                                   Foreground="#555555" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <!-- Chart instance is injected dynamically from TelemetryStreamView.xaml.cs -->
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- HORIZONTAL SPLITTER -->
        <GridSplitter Grid.Row="2" Height="3" HorizontalAlignment="Stretch" Background="#2A2A2A" Margin="0,2"/>

        <!-- BOTTOM HALF: LIVE READINGS TABLE -->
        <Border Grid.Row="3" Background="#181818" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="1" Padding="15" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="LIVE INCOMING TELEMETRY LOGS" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                <!-- REAL-TIME DATA GRID -->
                <DataGrid x:Name="TelemetryDataGrid" Grid.Row="1" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" Background="#121212" 
                          RowBackground="#1E1E1E" AlternatingRowBackground="#181818" 
                          Foreground="#FFFFFF" GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#2A2A2A" HeadersVisibility="Column" BorderThickness="0">

                    <!-- Custom Dark Column Header Style -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#252525"/>
                            <Setter Property="Foreground" Value="#FFC107"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#333333"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=\{0:HH:mm:ss\}}" Width="1.2*"/>
                        <DataGridTextColumn Header="MAC / Node ID" Binding="{Binding NodeMacAddress}" Width="2*"/>
                        <DataGridTextColumn Header="Zone" Binding="{Binding LocationZone}" Width="1.8*"/>
                        <DataGridTextColumn Header="Payload Value" Binding="{Binding PayloadValue, StringFormat=\{0:F2\}}" Width="1.5*"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding MetricUnit}" Width="1*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>