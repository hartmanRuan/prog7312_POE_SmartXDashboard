<UserControl x:Class="SmartXDashboard.TelemetryStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Loaded="TelemetryStreamView_Loaded"
             Unloaded="TelemetryStreamView_Unloaded"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#121212">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Bar: Filter Dropdown & Persistent Barcode Panel -->
            <RowDefinition Height="130"/>
            <!-- Spike History Log -->
            <RowDefinition Height="*"/>
            <!-- EXPANDED: Timeline Chart -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: NODE FILTER DROPDOWN & PERSISTENT SESSION BARCODE -->
        <Border Grid.Row="0" Background="#181818" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" BorderBrush="#2A2A2A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="REGISTERED NODE:" VerticalAlignment="Center" 
                           FontWeight="Bold" FontSize="11" Foreground="#FFC107" Margin="0,0,12,0"/>

                <ComboBox x:Name="NodeFilterComboBox" Grid.Column="1" Padding="6" FontSize="12" 
                          SelectionChanged="NodeFilterComboBox_SelectionChanged" Foreground="Black">
                    <ComboBoxItem Content="All Registered Nodes" IsSelected="True" Foreground="Black"/>
                </ComboBox>

                <!-- Persistent Session Barcode / Identifier Display -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Background="#222222" CornerRadius="4" Padding="8,4" BorderBrush="#333333" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SESSION BARCODE: " Foreground="#888888" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SessionBarcodeText" Text="NODE-MAC-LOC-01-SECURE" Foreground="#4CAF50" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveNodeStatusText" Text="Active Nodes: 1/1 Max" Foreground="#888888" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SPIKE HISTORY LOG -->
        <Border Grid.Row="1" Background="#181818" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="THRESHOLD SPIKE HISTORY (°C)" FontSize="11" FontWeight="Bold" Foreground="#FF5252" Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding SpikeHistory}" Background="#121212" BorderBrush="#222222" Foreground="#FFFFFF" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Foreground="#888888" Margin="0,0,15,0"/>
                                <TextBlock Text="Node:" Foreground="#AAAAAA" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding MacAddress}" FontWeight="Bold" Foreground="#FFC107" Margin="0,0,15,0"/>
                                <TextBlock Text="Value:" Foreground="#AAAAAA" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Value, StringFormat={}{0:F2}}" Foreground="#FF5252" FontWeight="Bold" Margin="0,0,2,0"/>
                                <TextBlock Text="{Binding Unit}" Foreground="#FF5252"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- EXPANDED LIVE TIMELINE GRAPH CONTAINER -->
        <Border Grid.Row="2" Background="#181818" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="LIVE TELEMETRY TIMELINE CHART (°C) &amp; THRESHOLDS" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="ChartSelectedNodeLabel" Text="Showing: Locked Single Node Stream" 
                               HorizontalAlignment="Right" FontSize="11" Foreground="#FFC107" FontWeight="SemiBold"/>
                </Grid>

                <!-- CHART VIEW AREA -->
                <Border Grid.Row="1" Background="#121212" CornerRadius="4" BorderBrush="#222222" BorderThickness="1" Padding="10">
                    <Grid x:Name="ChartContainer">
                        <TextBlock x:Name="EmptyChartPrompt" Text="Awaiting telemetry data stream..." 
                                   Foreground="#555555" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Panel.ZIndex="1"/>

                        <!-- LiveCharts2 CartesianChart bound to Series, XAxes, and YAxes -->
                        <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>